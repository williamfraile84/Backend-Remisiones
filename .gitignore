# Entornos virtuales y dependencias
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/

# Variables de entorno y secretos
.env
.env.*
!.env.example
*.env.local

# Bases de datos y almacenamiento local
