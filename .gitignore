storage_data/logos/*
!storage_data/logos/.gitkeep
storage_data/remisiones_firmadas/*
!storage_data/remisiones_firmadas/.gitkeep
storage_data/uploads/*
!storage_data/uploads/.gitkeep

# Pruebas y cobertura
.pytest_cache/
.coverage
htmlcov/

# Logs
*.log
logs/
