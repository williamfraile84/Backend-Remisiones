# ==============================================================================
# CONFIGURACIÓN GENERAL DEL SERVIDOR
# ==============================================================================
APP_ENV=production
API_PORT=8001
SERVER_PORT=8001
SERVER_HOST=0.0.0.0

# ==============================================================================
# CONFIGURACIÓN DE BASE DE DATOS (SQLITE LOCAL O SUPABASE / POSTGRESQL)
# ==============================================================================
DB_ENGINE=sqlite
DB_NAME=./storage_data/app.db

# Para conectar con PostgreSQL / Supabase, descomenta y configura:
# DB_ENGINE=postgresql
# DB_USER=your_database_user
# DB_PASSWORD=your_database_password
# DB_HOST=aws-0-region.pooler.supabase.com
# DB_PORT=5432
# DB_NAME=postgres
# DB_SSLMODE=require
# DB_USE_NULLPOOL=true

# ==============================================================================
# CONTROL DE MIGRACIÓN ENTRE BASES DE DATOS (BIDIRECCIONAL Y AGNÓSTICO)
# ==============================================================================
# ¿Migrar automáticamente al arrancar el servidor? (true / false)
AUTO_MIGRATE_DB=false

# URL o archivo de origen desde donde se leen los datos a migrar
# Ejemplos:
# MIGRATE_SOURCE_URL=sqlite:///./storage_data/app.db
# MIGRATE_SOURCE_URL=postgresql+psycopg2://postgres.user:pass@host:5432/postgres?sslmode=require
# MIGRATE_SOURCE_URL=mysql+pymysql://root:pass@localhost:3306/fruver_db
MIGRATE_SOURCE_URL=sqlite:///./storage_data/app.db

# URL de destino hacia donde se copiarán los datos.
# (Si se deja vacío, toma automáticamente la base de datos activa configurada arriba)
MIGRATE_TARGET_URL=

# ¿Limpiar las tablas de destino antes de insertar? (false = merge/upsert seguro, true = borra destino)
MIGRATE_RESET_DESTINATION=false

# ==============================================================================
# SEGURIDAD Y AUTENTICACIÓN JWT
# ==============================================================================
JWT_SECRET=cambiar-por-un-secreto-seguro-en-produccion-minimo-32-caracteres
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["*"]

# ==============================================================================
# USUARIO ADMINISTRADOR INICIAL (Se crea automáticamente al primer arranque)
# ==============================================================================
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin
INITIAL_ADMIN_NAME=Administrador Principal
INITIAL_ADMIN_EMAIL=admin@fruver.com

# ==============================================================================
# PARÁMETROS DE NEGOCIO Y CÁLCULOS FINANCIEROS
# ==============================================================================
# Margen de utilidad predeterminado por producto (%)
DEFAULT_PROFIT_MARGIN=30.0

# ==============================================================================
# PROVEEDOR DE ALMACENAMIENTO DE ARCHIVOS (STORAGE)
# Opciones disponibles: "local", "s3", "supabase", "google_drive", "file_server"
# ==============================================================================
STORAGE_PROVIDER=local
STORAGE_BASE_DIR=./storage_data

# --- OPCIÓN SUPABASE STORAGE / S3 / CLOUDFLARE R2 / AWS S3 ---
# Para usar Supabase Storage vía protocolo S3:
# Genera tus S3 Access Keys en: Supabase -> Project Settings -> Storage -> S3 Access Keys
# S3_ENDPOINT_URL=https://your-project.storage.supabase.co/storage/v1/s3
# S3_REGION_NAME=ca-central-1
# S3_ACCESS_KEY_ID=tu_s3_access_key_id
# S3_SECRET_ACCESS_KEY=tu_s3_secret_access_key
# S3_BUCKET_NAME=fruver-storage
# S3_USE_SSL=true
# S3_PUBLIC_URL_PREFIX=https://your-project.supabase.co/storage/v1/object/public/fruver-storage

# --- CONTROL DE MIGRACIÓN / SINCRONIZACIÓN DE ARCHIVOS ---
# Sincronizar automáticamente archivos al arrancar el backend (true / false)
AUTO_MIGRATE_STORAGE=false
# Proveedor de origen para migrar archivos ("local", "s3", "google_drive", "file_server")
MIGRATE_STORAGE_SOURCE=local
# Proveedor de destino (si se deja vacío, toma STORAGE_PROVIDER activo)
MIGRATE_STORAGE_TARGET=s3
# ¿Sobrescribir archivos si ya existen en destino? (false = sincronización incremental rápida)
MIGRATE_STORAGE_OVERWRITE=false

# Opciones para Google Drive (solo si STORAGE_PROVIDER=google_drive)
# GOOGLE_DRIVE_FOLDER_ID=1P0yV_di0ZsOo31H6ZJxiBjPtskudNa2d
# GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=./service_account.json
# GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=

# Opciones para File Server Remoto (solo si STORAGE_PROVIDER=file_server)
# FILE_SERVER_URL=http://tu-servidor-archivos.local/api
# FILE_SERVER_API_KEY=tu-api-key-secreta

# ==============================================================================
# POLÍTICAS DE CARGA DE ARCHIVOS Y FORMATOS PERMITIDOS
# ==============================================================================
MAX_FILE_SIZE_MB=15
ALLOWED_DOC_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.webp,.xlsx,.xls
ALLOWED_CLOSURE_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.webp

# ==============================================================================
# MOTOR DE VISIÓN MULTIMODAL CON INTELIGENCIA ARTIFICIAL (GOOGLE GEMINI)
# ==============================================================================
# Proveedor de visión inteligente: "gemini" (Google AI Multimodal)
VISION_PROVIDER=gemini
# Clave API de Google Gemini (obtenla gratis en https://aistudio.google.com/)
GEMINI_API_KEY=
# Modelo de Gemini a utilizar (con fallback automático a otros modelos flash)
GEMINI_MODEL=gemini-2.5-flash
VISION_MAX_IMAGE_DIMENSION=1600
VISION_PDF_DPI=150